#!name=AI 分流轻量版
#!desc=给现有 Shadowrocket 配置叠加 AI 规则；不创建新的代理分组，ChatGPT / Gemini / Claude / Grok / Perplexity / Cursor / Copilot 统一走主配置的 PROXY 策略。
#!author=qinkun212
#!homepage=https://github.com/qinkun212/Clash-rules

[Rule]

# OpenAI / ChatGPT / Sora
DOMAIN-SUFFIX,chatgpt.com,PROXY
DOMAIN-SUFFIX,openai.com,PROXY
DOMAIN-SUFFIX,oaistatic.com,PROXY
DOMAIN-SUFFIX,oaiusercontent.com,PROXY
DOMAIN-SUFFIX,sora.com,PROXY
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/OpenAI/OpenAI.list,PROXY

# Gemini / Google AI Studio
DOMAIN,gemini.google.com,PROXY
DOMAIN,aistudio.google.com,PROXY
DOMAIN,generativelanguage.googleapis.com,PROXY
DOMAIN,robinfrontend-pa.googleapis.com,PROXY
DOMAIN-SUFFIX,geller-pa.googleapis.com,PROXY
DOMAIN,alkalicore-pa.clients6.google.com,PROXY
DOMAIN,cloudcode-pa.googleapis.com,PROXY
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Gemini/Gemini.list,PROXY

# Claude / Anthropic
DOMAIN-SUFFIX,claude.ai,PROXY
DOMAIN-SUFFIX,claude.com,PROXY
DOMAIN-SUFFIX,anthropic.com,PROXY
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Claude/Claude.list,PROXY

# Grok / xAI
DOMAIN-SUFFIX,grok.com,PROXY
DOMAIN-SUFFIX,x.ai,PROXY

# Perplexity
DOMAIN-SUFFIX,perplexity.ai,PROXY
DOMAIN-SUFFIX,pplx.ai,PROXY

# Cursor
DOMAIN-SUFFIX,cursor.com,PROXY
DOMAIN-SUFFIX,cursor.sh,PROXY

# Microsoft / GitHub Copilot
DOMAIN,copilot.microsoft.com,PROXY
DOMAIN-SUFFIX,githubcopilot.com,PROXY
